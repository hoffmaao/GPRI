# Site-local paths -- copy to site.env (gitignored) and fill in.
# Everything machine-specific lives here and only here; the repository
# itself carries no hostnames, mount points, or storage layout.

# Root(s) of the GPRI data holdings, used by bin/survey_campaigns.py
# (colon-separated list of directories to walk):
GPRI_SURVEY_ROOTS=/path/to/archive:/path/to/projects

# One entry per processed scene directory the examples use (20170827 is
# the one `gpri focus` writes from raw; the others were processed by GAMMA):
GPRI_SCENE_20170827=/path/to/scene/20170827
GPRI_SCENE_20170803=/path/to/BakerBend1/20170803
GPRI_SCENE_20170713=/path/to/BakerBend1/20170713
GPRI_SCENE_20170713_full=/path/to/scene/20170713_full
GPRI_SCENE_20160826=/path/to/BakerBend1/20160826

# Optional: raw campaign directories (the instrument's .raw/.raw_par files)
# that `gpri focus` turns into scene directories:
GPRI_RAW_20170827=/path/to/archive/GPRI/20170827
GPRI_RAW_20170713=/path/to/archive/GPRI/20170713

# Optional: where bin/stage_data.sh stages working copies, and where the
# examples cache decimated phase/coherence stacks (a few GB per day and
# antenna; defaults to ./work):
GPRI_WORK_ROOT=/path/to/scratch
# Optional: RGI outlines for the glacier-mask audit:
GPRI_RGI=/path/to/rgi_61.zip
