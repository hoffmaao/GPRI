# Site-local paths -- copy to site.env (gitignored) and fill in.
# Everything machine-specific lives here and only here; the repository
# itself carries no hostnames, mount points, or storage layout.

# Root(s) of the GPRI data holdings, used by bin/survey_campaigns.py
# (colon-separated list of directories to walk):
GPRI_SURVEY_ROOTS=/path/to/archive:/path/to/projects

# One entry per processed scene directory the examples use.  The examples
# read every GPRI_SCENE_ entry set here, so a scene added below is picked up
# without touching any script, and `bin/run_scene.sh <name>` looks for
# GPRI_SCENE_<name>.  The `_full` scenes and 20170827, 20170913, 20180709,
# 20180808, 20190719 are what `gpri focus` writes from raw; 20170803,
# 20170713 and 20160826 are GAMMA's own products, kept in place beside them:
GPRI_SCENE_20170827=/path/to/scene/20170827
GPRI_SCENE_20170803=/path/to/BakerBend1/20170803
GPRI_SCENE_20170803_full=/path/to/scene/20170803_full
GPRI_SCENE_20170713=/path/to/BakerBend1/20170713
GPRI_SCENE_20170713_full=/path/to/scene/20170713_full
GPRI_SCENE_20170913=/path/to/scene/20170913
GPRI_SCENE_20180709=/path/to/scene/20180709
GPRI_SCENE_20180808=/path/to/scene/20180808
GPRI_SCENE_20190719=/path/to/scene/20190719
GPRI_SCENE_20160826=/path/to/BakerBend1/20160826
GPRI_SCENE_20160826_full=/path/to/scene/20160826_full

# Optional: raw campaign directories (the instrument's .raw/.raw_par files)
# that `gpri focus` turns into the scene directories above.  20180808 and
# 20190719 are only on the backup of the field computer (docs/campaigns.md);
# the rest are in the archive:
GPRI_RAW_20170827=/path/to/archive/GPRI/20170827
GPRI_RAW_20170803=/path/to/archive/GPRI/20170803
GPRI_RAW_20170713=/path/to/archive/GPRI/20170713
GPRI_RAW_20170913=/path/to/archive/GPRI/20170913
GPRI_RAW_20180709=/path/to/archive/GPRI/20180709
GPRI_RAW_20180808=/path/to/backup/GPRI/20180808
GPRI_RAW_20190719=/path/to/backup/GPRI/20190719
GPRI_RAW_20160826=/path/to/archive/GPRI/20160826

# Optional: where bin/stage_data.sh stages working copies, and where the
# examples cache decimated phase/coherence stacks (a few GB per day and
# antenna; defaults to ./work):
GPRI_WORK_ROOT=/path/to/scratch
# Optional: RGI outlines for the glacier-mask audit:
GPRI_RGI=/path/to/rgi_61.zip
# Optional: a DEM covering the swath, for `gpri heading` (the Copernicus
# 30 m tile N48 W122 covers BakerBend1; docs/campaigns.md says where):
GPRI_DEM=/path/to/Copernicus_DSM_COG_10_N48_00_W122_00_DEM.tif
